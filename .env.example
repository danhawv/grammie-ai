# ============================================================================
# Required
# ============================================================================
DATABASE_URL=postgres://user:password@host/dbname
SESSION_SECRET=your-random-secret-string-here

# ============================================================================
# AI Providers (at least one recommended)
# ============================================================================
AI_PROVIDER=gemini                          # "gemini" or "openai"
GEMINI_API_KEY=                             # Google AI Studio key
AI_INTEGRATIONS_OPENAI_API_KEY=             # OpenAI API key
AI_INTEGRATIONS_OPENAI_BASE_URL=            # OpenAI base URL (custom endpoint)

# ============================================================================
# Authentication
# ============================================================================
CLERK_SECRET_KEY=                           # Clerk backend key (optional - enables Clerk auth)
VITE_CLERK_PUBLISHABLE_KEY=                 # Clerk frontend key (optional - enables Clerk UI)

# ============================================================================
# Server
# ============================================================================
PORT=5000                                   # Railway sets this automatically
NODE_ENV=production
PUBLIC_URL=https://your-app.railway.app     # Used for CORS and OG images

# ============================================================================
# Optional Services
# ============================================================================
LULU_CLIENT_ID=                             # Lulu print-on-demand (OAuth2 client credentials)
LULU_CLIENT_SECRET=
LULU_ENVIRONMENT=sandbox                    # "sandbox" or "production"
APIFY_API_KEY=                              # Social media scraping (slow fallback)
SCRAPECREATORS_API_KEY=                     # Instagram reader when Instagram blocks the server
VITE_ELEVENLABS_AGENT_ID=                   # ElevenLabs voice agent
ADMIN_EMAILS=                               # Comma-separated admin emails
PUPPETEER_EXECUTABLE_PATH=                  # Chrome/Chromium path for PDF generation

# ============================================================================
# Bulk intake: "Bring in a whole box of recipes" (docs/BULK_IMPORT.md)
# Turns itself on once migrations/2026-10-bulk-intake.sql has run.
# ============================================================================
BULK_INTAKE=                                # "off" hides it even when the tables exist
BULK_MAX_PHOTOS_PER_BATCH=600               # photos in one box
BULK_MAX_PHOTOS_PER_MONTH=2000              # photos per person per 30 days
BULK_MAX_OPEN_BATCHES=3                     # boxes in progress per person
BULK_MAX_IMPORTS_PER_DAY=1000               # recipes imported from boxes per person per day
BULK_CONFIRM_ABOVE=100                      # more recipes than this needs an extra tick
BULK_CHECK_WORKERS=8                        # first-look calls at once
BULK_IMPORT_IN_FLIGHT=6                     # bulk recipes being read at once, per box
GOOGLE_DRIVE_CLIENT_ID=                     # OAuth client (Web) for the Drive picker
GOOGLE_DRIVE_API_KEY=                       # API key (Picker API + Drive API), HTTP-referrer restricted
GOOGLE_DRIVE_APP_ID=                        # Google Cloud project number
GOOGLE_DRIVE_LINKS=                         # "on" to also accept shared-folder links (public folders)
