# ============================================================================
# Required
# ============================================================================
DATABASE_URL=postgres://user:password@host/dbname
SESSION_SECRET=your-random-secret-string-here

# ============================================================================
# AI Providers (at least one recommended)
# ============================================================================
AI_PROVIDER=gemini                          # "gemini" or "openai"
GEMINI_API_KEY=                             # Google AI Studio key
AI_INTEGRATIONS_OPENAI_API_KEY=             # OpenAI API key
AI_INTEGRATIONS_OPENAI_BASE_URL=            # OpenAI base URL (custom endpoint)

# ============================================================================
# Authentication
# ============================================================================
CLERK_SECRET_KEY=                           # Clerk backend key (optional - enables Clerk auth)
VITE_CLERK_PUBLISHABLE_KEY=                 # Clerk frontend key (optional - enables Clerk UI)

# ============================================================================
# Server
# ============================================================================
PORT=5000                                   # Railway sets this automatically
NODE_ENV=production
PUBLIC_URL=https://your-app.railway.app     # Used for CORS and OG images

# ============================================================================
# Optional Services
# ============================================================================
LULU_CLIENT_ID=                             # Lulu print-on-demand (OAuth2 client credentials)
LULU_CLIENT_SECRET=
LULU_ENVIRONMENT=sandbox                    # "sandbox" or "production"
APIFY_API_KEY=                              # Social media scraping
VITE_ELEVENLABS_AGENT_ID=                   # ElevenLabs voice agent
ADMIN_EMAILS=                               # Comma-separated admin emails
PUPPETEER_EXECUTABLE_PATH=                  # Chrome/Chromium path for PDF generation
